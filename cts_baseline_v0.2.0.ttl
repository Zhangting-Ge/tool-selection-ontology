#======================================================================
# Alignment with KG4CUT v1.3.0
#
# SKOS matches, not owl:equivalentClass or owl:equivalentProperty.
# A match records the correspondence and has no effect on reasoning,
# so the domain and range axioms of KG4CUT are not inherited.
# exactMatch: same thing, same intent.
# closeMatch: the same subject, with a stated difference below.
#======================================================================

cts:CuttingTool     skos:exactMatch kg:CuttingTool .
cts:MillingTool     skos:exactMatch kg:MillingTool .
cts:SolidEndTool    skos:exactMatch kg:SolidEndTool .
cts:Pocket          skos:exactMatch kg:Pocket .
cts:Slot            skos:exactMatch kg:Slot .
cts:Shoulder        skos:exactMatch kg:Shoulder .
cts:Plane           skos:exactMatch kg:Plane .
cts:Chamfer         skos:exactMatch kg:Chamfer .
cts:Rougher         skos:exactMatch kg:Rougher .
cts:Finisher        skos:exactMatch kg:Finisher .

cts:Manufacturer    skos:closeMatch kg:CuttingToolManufacturer ;
    rdfs:comment "KG4CUT models the manufacturer as a subclass of foaf:Organization. This layer does not."@en .

cts:MaterialGroup   skos:closeMatch kg:ISOMaterialGroup ;
    rdfs:comment "This layer uses the six ISO 513 groups only. KG4CUT also carries the numbered subgroups P0 to P6, M1 to M3 and so on."@en .

cts:MillingOperation skos:closeMatch kg:MillingTask ;
    rdfs:comment "KG4CUT models operations as a class taxonomy with instances. This layer models them as instances only."@en .

cts:Feature         skos:closeMatch kg:FinalGeometry ;
    rdfs:comment "KG4CUT separates RawGeometry and FinalGeometry under WorkpieceGeometry. This layer has one feature class, because the baseline records the feature to be produced, not the stock."@en .

cts:ToolFunction    skos:closeMatch kg:ToolType ;
    rdfs:comment "KG4CUT expresses the functional role twice, as the class ToolType and as the string properties prefToolType and optToolType. This layer uses the class only."@en .

cts:ChamferTool     skos:closeMatch kg:Chamfering ;
    rdfs:comment "KG4CUT names the role after the operation. This layer names it after the tool."@en .

cts:cuttingDiameter skos:exactMatch kg:cutterDiameter .
cts:fluteLength     skos:exactMatch kg:hasCuttingLength .
cts:numberOfFlutes  skos:exactMatch kg:hasNumberOfFlutes .
cts:cornerRadius    skos:exactMatch kg:hasCornerRadius .
cts:coating         skos:exactMatch kg:hasCoating .
cts:shankType       skos:exactMatch kg:shankType .
cts:orderingNumber  skos:exactMatch kg:orderingNumber .
cts:hasManufacturer skos:exactMatch kg:hasCuttingToolManufacturer .

cts:overallLength   skos:closeMatch kg:hasLength ;
    rdfs:comment "kg:hasLength carries no domain and is used on both tools and other individuals, so the reference point is not stated there."@en .

cts:helixAngle      skos:closeMatch kg:hasFluteHelixAngle ;
    rdfs:comment "The range in KG4CUT is xsd:string. Here it is xsd:float in degrees."@en .

cts:maxRampAngle    skos:closeMatch kg:maxRampAngleDegree ;
    rdfs:comment "The range in KG4CUT is xsd:integer. Here it is xsd:float."@en .

cts:shankDiameter   skos:closeMatch kg:hasAdapterDiameter ;
    rdfs:comment "KG4CUT names the holder side of the connection. This layer names the tool side."@en .

cts:maxAxialDepthOfCut skos:closeMatch kg:hasAxialDepthOfCut ;
    rdfs:comment "KG4CUT records the depth actually used in a set of CuttingParameters. This layer records the largest depth the vendor allows for the tool. The two are not the same quantity."@en .

cts:machinesMaterial skos:closeMatch kg:primaryMachines ;
    rdfs:comment "KG4CUT expresses this twice, as the object property primaryMachines and as the string property preferredMat. This layer uses the object property only."@en .

cts:suitableFor     skos:closeMatch kg:hasPreferredOperationType ;
    rdfs:comment "KG4CUT separates preferred and optional operations. This layer does not make that distinction at the baseline level."@en .

cts:producedBy      skos:closeMatch kg:isPrimaryMachinedBy ;
    rdfs:comment "In KG4CUT the range is a milling task and the fillers are unions or intersections written on the class. Here the range is a milling operation and the statement is made on the instance."@en .

#======================================================================
# Disjointness of features
#
# A part feature is one of these five. Without this axiom a consistency
# check cannot fail, so passing it would carry no information.
#======================================================================

[] a owl:AllDisjointClasses ;
    owl:members ( cts:Pocket cts:Slot cts:Shoulder cts:Plane cts:Chamfer ) .

#======================================================================
# Feature instances from the interview cases
#
# Dimensions measured in NX on the case models. Only measured values are
# recorded. Dimensions that were not measured are absent, not estimated.
#======================================================================

cts:Case1-Bracket-Pocket a owl:NamedIndividual, cts:Pocket ;
    rdfs:label "bracket closed pocket"@en ;
    rdfs:comment "Case 1, warm-up case. Cast bracket, closed cavity. Measured in NX."@en ;
    cts:pocketDepth 9.5 ;
    cts:featureDepth 9.5 ;
    cts:minCornerRadius 7.5 ;
    cts:wallThickness 21.0 .

cts:Case2-Housing-Slot a owl:NamedIndividual, cts:Slot ;
    rdfs:label "housing cylinder U-slot"@en ;
    rdfs:comment "Case 2, thermostat housing. U-shaped slot on the cylinder. The width caps the tool diameter and the adjacent wall is thin. Measured in NX."@en ;
    cts:slotWidth 5.0 ;
    cts:wallThickness 2.0 .

cts:Case2-Housing-StepCorner a owl:NamedIndividual, cts:Shoulder ;
    rdfs:label "housing step corner"@en ;
    rdfs:comment "Case 2, thermostat housing. Internal corner of a step, radius 1 mm over a run of 4 mm. The corner radius caps the tool radius on a short length while the rest of the part allows a much larger tool. Run length is not recorded, the baseline has no property for it. Measured in NX."@en ;
    cts:minCornerRadius 1.0 .
