@prefix cts:  <https://w3id.org/cts/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix kg:   <https://w3id.org/kg4cut/> .

<https://w3id.org/cts> a owl:Ontology ;
    rdfs:label "Ontology-based tool selection assistant: baseline layer"@en ;
    rdfs:comment "The baseline layer holds what a vendor catalogue states about a tool. Property names follow the representation of ISO 13399-1, clause 5.2.93: each property has an identifier, a range, a description and a domain. Code level alignment with ISO 13399-3 is out of scope. Tool data comes from the Sandvik Generic Tool Catalogue package, which is ISO 10303-21 with the ISO 13399 dictionary."@en ;
    owl:versionInfo "0.2.0" ;
    dct:created "2026-09-08"^^xsd:date ;
    dct:modified "2026-09-16"^^xsd:date ;
    rdfs:comment "Version 0.2.0 adds three changes. Terms are mapped to KG4CUT v1.3.0 with SKOS matches rather than OWL equivalence, so the correspondence is recorded without importing KG4CUT axioms. The five feature subclasses are declared pairwise disjoint, so a consistency check can fail. Three feature instances from the interview cases are included; their dimensions were measured in NX."@en .

#======================================================================
# Classes
#======================================================================

cts:CuttingTool a owl:Class ;
    rdfs:label "cutting tool"@en ;
    rdfs:comment "Any tool used to remove material."@en .

cts:MillingTool a owl:Class ;
    rdfs:subClassOf cts:CuttingTool ;
    rdfs:label "milling tool"@en ;
    rdfs:comment "A rotating cutting tool for milling."@en .

cts:SolidEndTool a owl:Class ;
    rdfs:subClassOf cts:MillingTool ;
    rdfs:label "solid end mill"@en ;
    rdfs:comment "A milling tool made from one piece of carbide. The scope of this layer."@en .

cts:Manufacturer a owl:Class ;
    rdfs:label "manufacturer"@en ;
    rdfs:comment "A company that makes cutting tools."@en .

cts:ToolFunction a owl:Class ;
    rdfs:label "tool function"@en ;
    rdfs:comment "The role a tool plays in a process."@en .

cts:Rougher a owl:Class ;
    rdfs:subClassOf cts:ToolFunction ;
    rdfs:label "rougher"@en ;
    rdfs:comment "Removes material fast, surface quality is secondary."@en .

cts:Finisher a owl:Class ;
    rdfs:subClassOf cts:ToolFunction ;
    rdfs:label "finisher"@en ;
    rdfs:comment "Produces the final surface."@en .

cts:ChamferTool a owl:Class ;
    rdfs:subClassOf cts:ToolFunction ;
    rdfs:label "chamfer tool"@en ;
    rdfs:comment "Produces a chamfer."@en .

cts:MaterialGroup a owl:Class ;
    rdfs:label "material group"@en ;
    rdfs:comment "An ISO 513 workpiece material group."@en .

cts:MillingOperation a owl:Class ;
    rdfs:label "milling operation"@en ;
    rdfs:comment "A milling operation carried out on a workpiece."@en .

cts:Feature a owl:Class ;
    rdfs:label "feature"@en ;
    rdfs:comment "A geometric feature on the workpiece that has to be produced."@en .

cts:Pocket a owl:Class ;
    rdfs:subClassOf cts:Feature ;
    rdfs:label "pocket"@en ;
    rdfs:comment "A closed cavity. Needs a ramp or helical entry."@en .

cts:Slot a owl:Class ;
    rdfs:subClassOf cts:Feature ;
    rdfs:label "slot"@en ;
    rdfs:comment "A channel. The width caps the tool diameter."@en .

cts:Shoulder a owl:Class ;
    rdfs:subClassOf cts:Feature ;
    rdfs:label "shoulder"@en ;
    rdfs:comment "A step with a vertical and a horizontal face."@en .

cts:Plane a owl:Class ;
    rdfs:subClassOf cts:Feature ;
    rdfs:label "plane"@en ;
    rdfs:comment "A flat face."@en .

cts:Chamfer a owl:Class ;
    rdfs:subClassOf cts:Feature ;
    rdfs:label "chamfer"@en ;
    rdfs:comment "An angled edge."@en .

#======================================================================
# Object properties
#======================================================================

cts:hasManufacturer a owl:ObjectProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  cts:Manufacturer ;
    rdfs:label "has manufacturer"@en ;
    rdfs:comment "The vendor that makes this tool."@en .

cts:hasToolFunction a owl:ObjectProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  cts:ToolFunction ;
    rdfs:label "has tool function"@en ;
    rdfs:comment "Rougher, finisher or chamfering. Modelled as a class, not a string."@en .

cts:suitableFor a owl:ObjectProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  cts:MillingOperation ;
    rdfs:label "suitable for"@en ;
    rdfs:comment "An operation this tool is made for."@en .

cts:machinesMaterial a owl:ObjectProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  cts:MaterialGroup ;
    rdfs:label "machines material"@en ;
    rdfs:comment "An ISO 513 group this tool is released for. Not populated: not in the GTC package."@en .

cts:producedBy a owl:ObjectProperty ;
    rdfs:domain cts:Feature ;
    rdfs:range  cts:MillingOperation ;
    rdfs:label "produced by"@en ;
    rdfs:comment "The operation that produces this feature."@en .

cts:requiresTool a owl:ObjectProperty ;
    rdfs:domain cts:MillingOperation ;
    rdfs:range  cts:MillingTool ;
    rdfs:label "requires tool"@en ;
    rdfs:comment "A tool that can carry out this operation."@en .

#======================================================================
# Data properties. Every one carries a domain: without it a reasoner
# cannot tell which class the value belongs to.
#======================================================================

cts:cuttingDiameter a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "cutting diameter"@en ;
    rdfs:comment "Diameter of the cutting part."@en .

cts:shankDiameter a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "shank diameter"@en ;
    rdfs:comment "Diameter of the shank the holder clamps."@en .

cts:fluteLength a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "flute length"@en ;
    rdfs:comment "Length of the cutting edge. With the diameter it gives the length to diameter ratio."@en .

cts:overallLength a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "overall length"@en ;
    rdfs:comment "Total length of the tool."@en .

cts:functionalLength a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "functional length"@en ;
    rdfs:comment "Length from the gauge plane to the tool tip."@en .

cts:shankLength a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "shank length"@en ;
    rdfs:comment "Length of the shank."@en .

cts:cornerRadius a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "corner radius"@en ;
    rdfs:comment "Radius at the corner of the end face. A blank in the catalogue means zero."@en .

cts:numberOfFlutes a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:integer ;
    rdfs:label "number of flutes"@en ;
    rdfs:comment "Number of cutting edges."@en .

cts:helixAngle a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "helix angle"@en ;
    rdfs:comment "Angle of the flutes to the tool axis."@en .

cts:helixHand a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "helix hand"@en ;
    rdfs:comment "Right or left."@en .

cts:maxAxialDepthOfCut a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "max axial depth of cut"@en ;
    rdfs:comment "Largest depth along the tool axis the vendor allows."@en .

cts:maxRampAngle a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "max ramp angle"@en ;
    rdfs:comment "Largest ramping angle when entering the material."@en .

cts:maxOverhang a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "max overhang"@en ;
    rdfs:comment "Largest overhang the vendor allows. Experts often work below this value."@en .

cts:lengthDiameterRatio a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "length to diameter ratio"@en ;
    rdfs:comment "Usable length divided by cutting diameter."@en .

cts:maxRotationalSpeed a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:float ;
    rdfs:label "max rotational speed"@en ;
    rdfs:comment "Highest spindle speed for this tool."@en .

cts:coating a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "coating"@en ;
    rdfs:comment "Surface treatment. Absent when the tool is uncoated."@en .

cts:coatingProcess a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "coating process"@en ;
    rdfs:comment "PVD or CVD."@en .

cts:substrate a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "substrate"@en ;
    rdfs:comment "Carbide grade group, ISO 513 designation of the tool material."@en .

cts:gradeDesignation a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "grade designation"@en ;
    rdfs:comment "Vendor name for the carbide grade."@en .

cts:shankType a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "shank type"@en ;
    rdfs:comment "Form of the shank connection."@en .

cts:shankStandard a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "shank standard"@en ;
    rdfs:comment "Standard the shank follows, e.g. DIN6535."@en .

cts:diameterToleranceClass a owl:DatatypeProperty ;
    rdfs:domain cts:MillingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "diameter tolerance class"@en ;
    rdfs:comment "Tolerance class of the cutting diameter."@en .

cts:orderingNumber a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "ordering number"@en ;
    rdfs:comment "Vendor order code."@en .

cts:productId a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "product id"@en ;
    rdfs:comment "Vendor internal identifier."@en .

cts:productFamily a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "product family"@en ;
    rdfs:comment "Vendor product family."@en .

cts:toolStyleCode a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "tool style code"@en ;
    rdfs:comment "Vendor style code."@en .

cts:retrievedOn a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:date ;
    rdfs:label "retrieved on"@en ;
    rdfs:comment "Date the values were taken from the catalogue."@en .

cts:dataSource a owl:DatatypeProperty ;
    rdfs:domain cts:CuttingTool ;
    rdfs:range  xsd:string ;
    rdfs:label "data source"@en ;
    rdfs:comment "Which catalogue package the values came from."@en .

cts:slotWidth a owl:DatatypeProperty ;
    rdfs:domain cts:Slot ;
    rdfs:range  xsd:float ;
    rdfs:label "slot width"@en ;
    rdfs:comment "Width of the slot. Caps the tool diameter."@en .

cts:slotDepth a owl:DatatypeProperty ;
    rdfs:domain cts:Slot ;
    rdfs:range  xsd:float ;
    rdfs:label "slot depth"@en ;
    rdfs:comment "Depth of the slot."@en .

cts:pocketDepth a owl:DatatypeProperty ;
    rdfs:domain cts:Pocket ;
    rdfs:range  xsd:float ;
    rdfs:label "pocket depth"@en ;
    rdfs:comment "Depth of the pocket."@en .

cts:minCornerRadius a owl:DatatypeProperty ;
    rdfs:domain cts:Feature ;
    rdfs:range  xsd:float ;
    rdfs:label "min corner radius"@en ;
    rdfs:comment "Smallest internal corner radius of the feature. Caps the tool corner radius."@en .

cts:wallThickness a owl:DatatypeProperty ;
    rdfs:domain cts:Feature ;
    rdfs:range  xsd:float ;
    rdfs:label "wall thickness"@en ;
    rdfs:comment "Thinnest wall next to the feature."@en .

cts:featureDepth a owl:DatatypeProperty ;
    rdfs:domain cts:Feature ;
    rdfs:range  xsd:float ;
    rdfs:label "feature depth"@en ;
    rdfs:comment "How deep the tool has to reach into the feature."@en .

#======================================================================
# ISO 513 material groups and milling operations
#======================================================================

cts:ISO513-P a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "P — steel"@en .

cts:ISO513-M a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "M — stainless steel"@en .

cts:ISO513-K a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "K — cast iron"@en .

cts:ISO513-N a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "N — non-ferrous"@en .

cts:ISO513-S a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "S — superalloy and titanium"@en .

cts:ISO513-H a owl:NamedIndividual, cts:MaterialGroup ;
    rdfs:label "H — hardened steel"@en .

cts:FaceMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "face milling"@en .

cts:SlotMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "slot milling"@en .

cts:ShoulderMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "shoulder milling"@en .

cts:PocketMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "pocket milling"@en .

cts:Ramping a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "ramping"@en .

cts:HelicalInterpolation a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "helical interpolation"@en .

cts:ProfileMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "profile milling"@en .

cts:ChamferMilling a owl:NamedIndividual, cts:MillingOperation ;
    rdfs:label "chamfer milling"@en .

cts:Sandvik-Coromant a owl:NamedIndividual, cts:Manufacturer ;
    rdfs:label "Sandvik Coromant"@en .

